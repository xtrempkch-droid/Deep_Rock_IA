# ai-cpu-os — artefatos a ignorar
# Runtime/data dos papéis (antes da refatoração isto era profiles/<cpu>/data)
roles/*/data/
*.part
*.gguf
*.log

# ISO (imagens e diretório de trabalho do gerador)
iso/work/
iso/out/
*.iso
# Trava de instância única do gerador (flock; ver acquire_build_lock em iso/build-iso.sh)
iso/.build-iso.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Backups gerados pelos scripts
*.bak.*

# Gerador de ISO: payload baixado e índices de repositório
iso/*.tar.gz
iso/*.tar.xz
/llama-src.tar.gz
