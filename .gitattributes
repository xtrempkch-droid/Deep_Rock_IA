# Normalização de finais de linha — scripts Bash DEVEM ter LF.
# CRLF em scripts Bash causa erros crípticos ("bad interpreter").
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# Binários (nunca normalizar)
*.gguf binary
*.png  binary
*.jpg  binary
*.gz   binary
*.tar  binary
