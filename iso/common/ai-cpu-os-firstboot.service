[Unit]
Description=ai-cpu-os: aplicar mods e instalar o papel (primeiro boot)
Documentation=file:///opt/ai-cpu-os/docs/ISO.md
# Precisa de rede para clonar o llama.cpp (papel inference) e baixar pacotes.
After=network-online.target
Wants=network-online.target
# Não atrapalha o boot: roda depois que o sistema já subiu.
After=multi-user.target

# Só executa enquanto a sentinela existir (garante "rodar uma vez só").
ConditionPathExists=/opt/ai-cpu-os/.firstboot-pending

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/opt/ai-cpu-os/iso/firstboot.sh
# A compilação do llama.cpp pode demorar bastante (10-20 min no Xeon).
TimeoutStartSec=infinity
# journal+console: o journal guarda tudo, e o CONSOLE (ttyS0 quando a ISO é
# gerada com --serial-console) deixa o teste de VM headless ver os marcadores
# ("aplicação concluída com sucesso") sem tela nem login. Com `journal` apenas,
# o iso/test-vm.sh nunca enxergava o fim do primeiro boot.
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=ai-cpu-os-firstboot

[Install]
WantedBy=multi-user.target
