# EditorConfig — mantém o estilo consistente entre editores.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Em Markdown, dois espaços finais significam quebra de linha: não remover.
trim_trailing_whitespace = false
